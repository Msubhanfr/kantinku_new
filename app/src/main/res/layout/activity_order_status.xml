<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Status Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:backgroundTint="#FFF8E1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvOrderId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#ORD-88291"
                    android:textSize="12sp"
                    android:textColor="@color/tertiary"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="SEDANG DIMASAK"
                    android:textSize="10sp"
                    android:textColor="@color/tertiary"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/tvStatusTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Pesananmu lagi diolah nih!"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Estimasi Waktu Tunggu"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface_secondary" />

                <TextView
                    android:id="@+id/tvEstimationTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10 menit"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary" />

                <TextView
                    android:id="@+id/tvTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="10:00"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/tertiary"
                    android:fontFamily="monospace" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Progress Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="Progress Pesanan"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:progressTint="@color/primary"
            android:progressBackgroundTint="@color/outline_variant"
            android:progress="25" />

        <!-- Timeline Steps -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <!-- Step 1: Pesanan diterima -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:id="@+id/ivStep1Icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_check_circle"
                    android:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStep1Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pesanan diterima"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStep1Time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12:45"
                        android:textSize="11sp"
                        android:textColor="@color/on_surface_secondary" />

                    <TextView
                        android:id="@+id/tvStep1Location"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kantin Bu Sumi"
                        android:textSize="11sp"
                        android:textColor="@color/on_surface_secondary" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:id="@+id/viewStep1"
                android:layout_width="2dp"
                android:layout_height="20dp"
                android:layout_marginStart="11dp"
                android:background="@color/primary" />

            <!-- Step 2: Sedang dimasak -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:id="@+id/ivStep2Icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_cooking"
                    android:tint="@color/on_surface_disabled" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStep2Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sedang dimasak"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface_secondary" />

                    <TextView
                        android:id="@+id/tvStep2Desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chef sedang menyiapkan hidanganmu"
                        android:textSize="11sp"
                        android:textColor="@color/on_surface_secondary" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:id="@+id/viewStep2"
                android:layout_width="2dp"
                android:layout_height="20dp"
                android:layout_marginStart="11dp"
                android:background="@color/outline_variant" />

            <!-- Step 3: Siap diambil -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:id="@+id/ivStep3Icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_storefront"
                    android:tint="@color/on_surface_disabled" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStep3Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Siap diambil"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface_secondary" />

                    <TextView
                        android:id="@+id/tvStep3Desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Segera ambil di counter 3"
                        android:textSize="11sp"
                        android:textColor="@color/on_surface_secondary" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:id="@+id/viewStep3"
                android:layout_width="2dp"
                android:layout_height="20dp"
                android:layout_marginStart="11dp"
                android:background="@color/outline_variant" />

            <!-- Step 4: Selesai -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <ImageView
                    android:id="@+id/ivStep4Icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_check_circle"
                    android:tint="@color/on_surface_disabled" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStep4Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selesai"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nikmati makananmu!"
                        android:textSize="11sp"
                        android:textColor="@color/on_surface_secondary" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Menu Pesanan Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="MENU PESANAN"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface_secondary" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvMenuItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nasi Goreng Spesial + Telur"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvItemPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp 18.000"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Informasi Tambahan -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOKASI"
                    android:textSize="10sp"
                    android:textColor="@color/on_surface_secondary"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/tvLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gedung C, Lt 1"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="METODE BAYAR"
                    android:textSize="10sp"
                    android:textColor="@color/on_surface_secondary"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/tvPaymentMethod"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Saldo Kantin"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Help Button -->
        <Button
            android:id="@+id/btnHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:text="❓ Bantuan Masalah Pesanan"
            android:textSize="14sp"
            android:backgroundTint="@color/surface_container_high"
            android:textColor="@color/primary"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    </LinearLayout>

</ScrollView>