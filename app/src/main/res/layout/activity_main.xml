<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_container_lowest"
        android:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/surface_container_lowest"
            android:paddingHorizontal="16dp"
            app:titleTextColor="@color/on_surface"
            app:title="@string/app_name">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivNotification"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_notification_empty"
                    app:tint="@color/on_surface_secondary"
                    android:padding="4dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/notification" />

                <ImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_profile"
                    app:tint="@color/primary"
                    android:padding="4dp"
                    android:contentDescription="@string/profile" />

            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Fragment Container -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="80dp"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph" />

    <!-- FLOATING DOCK - Glassmorphism -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomDock"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:layout_gravity="bottom"
        app:cardCornerRadius="35dp"
        app:cardElevation="0dp"
        android:background="@drawable/bg_glass"
        app:cardPreventCornerOverlap="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:baselineAligned="false">

            <!-- Home -->
            <TextView
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                app:drawableTopCompat="@drawable/ic_home"
                android:drawablePadding="4dp"
                android:text="@string/home"
                android:textSize="11sp"
                android:textColor="@color/primary"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/home" />

            <!-- Menu -->
            <TextView
                android:id="@+id/navMenu"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                app:drawableTopCompat="@drawable/ic_menu"
                android:drawablePadding="4dp"
                android:text="@string/menu"
                android:textSize="11sp"
                android:textColor="@color/on_surface_secondary"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/menu" />

            <!-- Cart -->
            <TextView
                android:id="@+id/navCart"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                app:drawableTopCompat="@drawable/ic_cart"
                android:drawablePadding="4dp"
                android:text="@string/cart"
                android:textSize="11sp"
                android:textColor="@color/on_surface_secondary"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/cart" />

            <!-- History -->
            <TextView
                android:id="@+id/navHistory"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                app:drawableTopCompat="@drawable/ic_history"
                android:drawablePadding="4dp"
                android:text="@string/history"
                android:textSize="11sp"
                android:textColor="@color/on_surface_secondary"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/history" />

            <!-- Profile -->
            <TextView
                android:id="@+id/navProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                app:drawableTopCompat="@drawable/ic_profile"
                android:drawablePadding="4dp"
                android:text="@string/profile"
                android:textSize="11sp"
                android:textColor="@color/on_surface_secondary"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/profile" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>