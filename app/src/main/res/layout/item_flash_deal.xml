<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    android:backgroundTint="#FFF3E0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Flash Deal Badge -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ FLASH DEAL"
            android:textSize="10sp"
            android:textColor="#FF5722"
            android:textStyle="bold" />

        <!-- Item Image -->
        <View
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:layout_marginVertical="8dp"
            android:background="#FF5722"
            android:backgroundTint="#FFEBEE" />

        <TextView
            android:id="@+id/tvDealName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pisang Goreng Madu"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDealDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sempurna untuk camilan sore..."
            android:textSize="10sp"
            android:textColor="#666666"
            android:maxLines="2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvOriginalPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Rp 15.000"
                android:textSize="10sp"
                android:textColor="#999999"
                android:textDecoration="line-through" />

            <TextView
                android:id="@+id/tvDealPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 12.000"
                android:textSize="14sp"
                android:textColor="#FF5722"
                android:textStyle="bold" />

        </LinearLayout>

        <Button
            android:id="@+id/btnAdd"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            android:text="Tambah +"
            android:textSize="11sp"
            android:backgroundTint="#4CAF50" />

    </LinearLayout>

</androidx.cardview.widget.CardView>