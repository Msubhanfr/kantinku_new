<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="180dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    android:background="@color/surface_container_lowest">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Image Placeholder -->
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_restaurant"
            android:backgroundTint="@color/primary_light"
            android:padding="16dp" />

        <TextView
            android:id="@+id/tvWarungName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Warung Mbok Galak"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4.8 ★"
                android:textSize="11sp"
                android:textColor="@color/tertiary" />

            <TextView
                android:id="@+id/tvDistance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=" • 200m"
                android:textSize="11sp"
                android:textColor="@color/on_surface_secondary"
                android:textAlignment="viewEnd" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvEstimatedTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="10-15 min"
            android:textSize="10sp"
            android:textColor="@color/on_surface_secondary"
            android:drawableStart="@drawable/ic_timer"
            android:drawablePadding="4dp" />

        <TextView
            android:id="@+id/tvCuisineType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Jawa & Prasmanan"
            android:textSize="10sp"
            android:textColor="@color/on_surface_disabled" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="● Buka"
            android:textSize="10sp"
            android:textColor="@color/success" />

    </LinearLayout>

</androidx.cardview.widget.CardView>