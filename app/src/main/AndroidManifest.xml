<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Tambahkan permission untuk internet -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Kantin-Ku"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KantinKu"
        android:usesCleartextTraffic="true">

        <!-- Splash Screen (Launcher) -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.KantinKu">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Onboarding Screen -->
        <activity
            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.KantinKu" />

        <!-- Login Activity -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main Activity -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false" />

        <!-- Cart Activity -->
        <activity
            android:name=".ui.cart.CartActivity"
            android:exported="false"
            android:parentActivityName=".ui.main.MainActivity" />

        <!-- Payment Activity -->
        <activity
            android:name=".ui.payment.PaymentActivity"
            android:exported="false"
            android:parentActivityName=".ui.cart.CartActivity" />

        <!-- Order Status Activity -->
        <activity
            android:name=".ui.order.OrderStatusActivity"
            android:exported="false"
            android:parentActivityName=".ui.cart.CartActivity" />

        <!-- Seller Dashboard Activity -->
        <activity
            android:name=".ui.seller.SellerDashboardActivity"
            android:exported="false"
            android:parentActivityName=".ui.main.MainActivity" />

    </application>

</manifest>